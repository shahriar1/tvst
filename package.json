{
  "name": "tvst",
  "version": "1.0.0",
  "description": "TV Shows Tracker (TVST) on the command line",
  "type": "module",
  "bin": {
    "tvst": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:live": "TVST_LIVE=1 vitest run --project live",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "prepack": "npm run build"
  },
  "author": {
    "name": "Shahriar Mahmood",
    "url": "https://github.com/shahriar1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahriar1/tvst.git"
  },
  "homepage": "https://github.com/shahriar1/tvst#readme",
  "bugs": {
    "url": "https://github.com/shahriar1/tvst/issues"
  },
  "keywords": [
    "tv",
    "tvmaze",
    "tv-shows",
    "shows",
    "series",
    "episodes",
    "schedule",
    "tracker",
    "cli",
    "typescript"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "chrono-node": "^2.10.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "luxon": "^3.7.2",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.3",
    "execa": "^10.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
